# No credentials are required for local unranked heuristic play.
PORT=8787
ORIGIN=http://localhost:8787
DB_PATH=./data/guess-who.sqlite
# Keep production deployment HTTPS. The local launcher defaults to loopback only.
HOST=127.0.0.1
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=3000
# Optional cost input; never silently assume a current provider price.
JEV_INPUT_USD_PER_MILLION=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Generate separately with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LAUNCH_SIGNING_KEY=
RATE_LIMIT_HASH_KEY=
# Bounded operational retention: detailed terminal matches vs aggregated official results.
MATCH_RETENTION_DAYS=90
RESULT_RETENTION_DAYS=730
